{
  "expo": {
    "name": "Activistly",
    "slug": "Activistly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "activistly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your location to help others find you on the crowd map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Share your location to help others find you on the crowd map.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth is used for peer-to-peer communication with nearby protesters.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth is used for peer-to-peer communication with nearby protesters."
      },
      "bundleIdentifier": "com.activistly.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#191A1F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.NEARBY_WIFI_DEVICES"
      ],
      "package": "com.activistly.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#191A1F",
          "dark": {
            "backgroundColor": "#191A1F"
          }
        }
      ],
      ["expo-font"],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
